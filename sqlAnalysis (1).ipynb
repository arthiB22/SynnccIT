        "\n",
        "def get_database_schema():\n",
        "    \"\"\"Get complete database schema for context\"\"\"\n",
        "    schema_info = \"\"\"\n",
        "Database Schema:\n",
        "\n",
        "1. customers table:\n",
        "   - customer_id (INTEGER): Unique customer identifier\n",
        "   - first_name (TEXT): Customer's first name\n",
        "   - last_name (TEXT): Customer's last name\n",
        "   - email (TEXT): Customer's email address\n",
        "   - city (TEXT): Customer's city\n",
        "   - signup_date (TEXT): Date when customer signed up (YYYY-MM-DD format)\n",
        "\n",
        "2. products table:\n",
        "   - product_id (INTEGER): Unique product identifier\n",
        "   - product_name (TEXT): Product name\n",
        "   - category (TEXT): Product category (Electronics, Clothing, Home & Garden, Sports, Books)\n",
        "   - price (REAL): Product price in dollars\n",
        "   - stock_quantity (INTEGER): Available stock quantity\n",
        "\n",
        "3. orders table:\n",
        "   - order_id (INTEGER): Unique order identifier\n",
        "   - customer_id (INTEGER): Foreign key to customers table\n",
        "   - order_date (TEXT): Date when order was placed (YYYY-MM-DD format)\n",
        "   - status (TEXT): Order status (Completed, Pending, Shipped, Cancelled)\n",
        "   - total_amount (REAL): Total order amount in dollars\n",
        "\n",
        "4. order_items table:\n",
        "   - item_id (INTEGER): Unique item identifier\n",
        "   - order_id (INTEGER): Foreign key to orders table\n",
        "   - product_id (INTEGER): Foreign key to products table\n",
        "   - quantity (INTEGER): Quantity of product ordered\n",
        "   - price (REAL): Price per unit at time of order\n",
        "   - subtotal (REAL): Total price for this item (quantity * price)\n",
        "\n",
        "Relationships:\n",
        "- customers.customer_id → orders.customer_id (one-to-many)\n",
        "- orders.order_id → order_items.order_id (one-to-many)\n",
        "- products.product_id → order_items.product_id (one-to-many)\n",
        "\"\"\"\n",
        "    return schema_info\n",
        "\n",
        "def natural_language_to_sql(prompt):\n",
        "    \"\"\"Convert natural language query to SQL using Gemini\"\"\"\n",
        "    schema = get_database_schema()\n",
        "\n",
        "    full_prompt = f\"\"\"{schema}\n",
        "\n",
        "\n",
        "\n",
        "Natural language query: {prompt}\n",
        "\n",
        "SQL query:\"\"\"\n",
        "\n",
        "    try:\n",
        "        response = model.generate_content(full_prompt)\n",
        "        sql_query = response.text.strip()\n",
        "\n",
        "        # Clean up any markdown formatting that might slip through\n",
        "        sql_query = sql_query.replace('```sql', '').replace('```', '').strip()\n",
        "\n",
        "        return sql_query\n",
        "    except Exception as e:\n",
        "        return f\"Error generating SQL: {str(e)}\"\n",
        "\n",
        "def execute_natural_language_query(prompt, show_sql=True):\n",
        "    \"\"\"Execute a natural language query and return results\"\"\"\n",
        "\n",
        "    print(\"\\n\" + \"=\"*70)\n",
        "    print(f\" NATURAL LANGUAGE QUERY:\")\n",
        "    print(f\"   {prompt}\")\n",
        "    print(\"=\"*70)\n",
        "\n",
        "    print(\"\\n Converting to SQL...\")\n",
        "    sql_query = natural_language_to_sql(prompt)\n",
        "\n",
        "    if show_sql:\n",
        "        print(f\"\\n GENERATED SQL QUERY:\")\n",
        "        print(f\"   {sql_query}\")\n",
        "\n",
        "    print(\"\\n Executing query...\")\n",
        "\n",
        "    try:\n",
        "        result_df = pd.read_sql_query(sql_query, conn)\n",
        "        print(f\"\\n RESULTS ({len(result_df)} rows):\")\n",
        "        print(\"=\"*70)\n",
        "        display(result_df)\n",
        "        return result_df\n",
        "    except Exception as e:\n",
        "        print(f\"\\n ERROR: {str(e)}\")\n",
        "        print(\"\\n TIP: Try rephrasing your question or check the SQL query above\")\n",
        "        return None\n",
        "\n",
        "print(\"\\n✅ Natural Language to SQL converter is ready!\")\n",
        "\n",
        "\n",
        "\n"
      ],
