            "⏳ Converting to SQL...\n",
            "\n",
            "📝 GENERATED SQL QUERY:\n",
            "   SELECT\n",
            "  p.category,\n",
            "  SUM(oi.subtotal) AS total_revenue\n",
            "FROM products AS p\n",
            "JOIN order_items AS oi\n",
            "  ON p.product_id = oi.product_id\n",
            "GROUP BY\n",
            "  p.category\n",
            "ORDER BY\n",
            "  total_revenue DESC\n",
